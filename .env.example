# ===========================================
# HELPY ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to git!

# -------------------------------------------
# SUPABASE (Required)
# -------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key (for API routes only - never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------
# CLERK AUTHENTICATION (Required)
# -------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# -------------------------------------------
# STRIPE PAYMENTS (Required for subscriptions)
# -------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Price IDs from Stripe Dashboard
STRIPE_PRICE_ID_MONTHLY=price_xxxxx
STRIPE_PRICE_ID_YEARLY=price_xxxxx

# -------------------------------------------
# PUSH NOTIFICATIONS (Required for notifications)
# -------------------------------------------
# Generate VAPID keys using browser script (see docs/VAPID_KEYS_BACKUP.md)
VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key-pkcs8-format
VAPID_SUBJECT=mailto:hello@helpyfam.com

# -------------------------------------------
# GOOGLE GEMINI AI (Required for AI features)
# -------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# -------------------------------------------
# APP CONFIGURATION (Optional)
# -------------------------------------------
VITE_APP_URL=https://app.helpyfam.com
NEXT_PUBLIC_APP_URL=https://app.helpyfam.com

# -------------------------------------------
# DEVELOPMENT/TESTING (Optional)
# -------------------------------------------
# Email that receives their own notifications (for testing)
NOTIFICATION_TEST_EMAIL=

# Node environment
NODE_ENV=development
